{
  "name": "studio-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "codegen": "node scripts/convex_codegen.js",
    "codegen:insecure": "node scripts/convex_codegen.js --insecure",
    "convex:login": "node scripts/convex_login.js",
    "convex:login:insecure": "node scripts/convex_login.js --insecure",
    "convex:dev": "node scripts/convex_dev.js",
    "convex:dev:insecure": "node scripts/convex_dev.js --insecure",
    "dev": "next dev --webpack",
    "prebuild": "node -e \"if (process.env.VERCEL) { process.exit(0) } if (process.env.SKIP_CONVEX_CODEGEN) { console.log('Skipping Convex codegen (SKIP_CONVEX_CODEGEN=1)'); process.exit(0) } if (!process.env.CONVEX_DEPLOYMENT) { console.log('Skipping Convex codegen (no CONVEX_DEPLOYMENT set)'); process.exit(0) } require('child_process').execSync('npm run codegen', {stdio: 'inherit'})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:sdk:mojibake": "node scripts/check_sdk_mojibake.mjs",
    "test:sdk": "node scripts/check_sdk_mojibake.mjs && node --test convex/sdk/__tests__/*.test.mjs convex/sdk/vnext/__tests__/*.test.mjs",
    "test:vnext": "node --test convex/sdk/vnext/__tests__/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "convex": "^1.31.2",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.7.2",
    "next": "^16.1.1",
    "openai": "^6.15.0",
    "openai-agents": "^1.1.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.55.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}